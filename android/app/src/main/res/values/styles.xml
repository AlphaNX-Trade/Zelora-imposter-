<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#7C3AED</item>
        <item name="colorPrimaryDark">#09090D</item>
        <item name="colorAccent">#38BDF8</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">#09090D</item>
        <item name="android:navigationBarColor">#09090D</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">#09090D</item>
        <item name="android:navigationBarColor">#09090D</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#09090D</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>